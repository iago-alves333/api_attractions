# Configurações do Banco de Dados PostgreSQL / PostGIS
DB_HOST=localhost
DB_PORT=5434
DB_NAME=titureco
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# Configurações do pgAdmin
PGADMIN_EMAIL=admin@titureco.com
PGADMIN_PASSWORD=CHANGE_ME

# Redis
REDIS_PASSWORD=

# JWT
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_WITH_AT_LEAST_32_CHARS

# Admin Seed (senha do usuário admin criado no primeiro boot)
ADMIN_SEED_PASSWORD=CHANGE_ME

# CORS (origens separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Grafana
GF_ADMIN_PASSWORD=CHANGE_ME
